{
  "name": "duang-landing",
  "version": "0.3.1",
  "private": true,
  "description": "Duang personal landing page, static Next.js export for Cloudflare Pages",
  "author": "Duang777",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Duang777/duang-landing.git"
  },
  "homepage": "https://duang-landing.pages.dev",
  "bugs": {
    "url": "https://github.com/Duang777/duang-landing/issues"
  },
  "keywords": [
    "duang",
    "landing",
    "nextjs",
    "cloudflare-pages",
    "personal-site"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "sync:posts": "node scripts/sync-posts.mjs",
    "prebuild": "npm run sync:posts",
    "build": "next build",
    "start": "npx --yes serve@14 out -l 3456",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
